{
  "name": "@knockport/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@knockport/core": "workspace:*",
    "@knockport/format": "workspace:*",
    "@knockport/transport": "workspace:*",
    "@knockport/storage": "workspace:*",
    "@knockport/engine": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3",
    "cmdk": "^1.0.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/view": "^6.35.0",
    "@codemirror/state": "^6.5.0",
    "codemirror": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "react-resizable-panels": "^2.1.7",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
